/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Basalt verwendet Automation, um Dateien zu verschieben, Objekte in den Papierkorb zu legen, angeforderte Befehle zu öffnen und die Wiedergabe in deinen Medienapps zu steuern.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Basalt nutzt den Ton jeder App, um ihre Lautstärke im Mixer zu regeln, die Musikbalken von Dynamic Island zu bewegen und den Ton des Mac in die Bildschirmaufnahmen aufzunehmen, die du startest. Nichts verlässt deinen Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Basalt verwendet Bluetooth nur, um den Akkustand verbundener Peripheriegeräte zu lesen. Nichts verlässt deinen Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Basalt nimmt dein Mikrofon nur auf, wenn du es für eine Bildschirmaufnahme einschaltest. Der Ton bleibt auf deinem Mac, außer du erstellst einen temporären Link.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Basalt zeigt deine Kamera nur im Vorschaufenster, das du öffnest, damit du vor einem Anruf prüfen kannst, wie du aussiehst. Es wird nichts aufgezeichnet und nichts verlässt deinen Mac.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Basalt prüft lokale Metadaten in Downloads, um nur ausgewählte bestätigte WhatsApp-Dateien zu prüfen, zu organisieren oder in den Papierkorb zu verschieben. Aufräumen sucht außerdem nach vergessenen Bildschirmfotos, wenn du sie hier speicherst.";

/* macOS user-selected organizer destination prompts. */
"NSDesktopFolderUsageDescription" = "Basalt organisiert bestätigte WhatsApp-Downloads in einem Zielordner, den du ausdrücklich auswählst. Aufräumen sucht außerdem nach vergessenen Bildschirmfotos, wenn du sie hier speicherst.";
